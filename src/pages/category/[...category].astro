---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { normalizeCategory } from '../../utils/blog';
import { getPublishedPosts } from '../../utils/collection';
import { blogPostUrl, categoriesUrl } from '../../utils/path';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allCategories = new Set<string>();
  posts.forEach((post) => {
    allCategories.add(normalizeCategory(post.data.category));
  });

  return [...allCategories].map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;

const categoryPosts = (await getPublishedPosts()).filter(
  (post) => normalizeCategory(post.data.category) === category,
);
---

<BaseLayout title={`${category} | ${SITE_TITLE}`}>
  <section class="listing-page">
    <div class="unified-page-header">
      <p class="unified-page-eyebrow">Category</p>
      <h1>{category}</h1>
      <div class="rule"></div>
      <p class="unified-page-subtitle">
        共 <span class="accent">{categoryPosts.length}</span> 篇文章
      </p>
    </div>

    {categoryPosts.length > 0 ? (
      <ul class="log-list">
        {categoryPosts.map((post) => (
          <PostCard
            slug={blogPostUrl(post.id)}
            title={post.data.title}
            description={post.data.description}
            body={post.body}
            pubDate={post.data.pubDate}
            category={category}
            tags={post.data.tags}
          />
        ))}
      </ul>
    ) : (
      <div class="empty-list">
        <div class="empty-list-icon">⊘</div>
        <p class="empty-list-text">该分类下暂无文章</p>
      </div>
    )}

    <div class="view-all">
      <a href={categoriesUrl()}>← 返回所有分类</a>
    </div>
  </section>
</BaseLayout>
