---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allCategories = new Set<string>();
  posts.forEach((post) => {
    const cat = (post.data.category && post.data.category.trim()) ? post.data.category : '未分类';
    allCategories.add(cat);
  });

  return [...allCategories].map((category) => ({
    params: { category },
  }));
}

const base = import.meta.env.BASE_URL;
const isRootBase = base === '/' || base === '';
function blogSlug(slug: string) { return isRootBase ? `/blog/${slug}/` : `${base}/blog/${slug}/`; }
const { category } = Astro.params;

// Same normalization as categories page
function getCategoryFilter(category: string): (post: any) => boolean {
  if (category === '未分类') {
    return (post) => (!post.data.category || !post.data.category.trim());
  }
  return (post) => post.data.category === category;
}

const categoryPosts = (await getCollection('blog'))
  .filter(getCategoryFilter(category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${category} | Atom Blog`}>
  <section class="listing-page">
    <div class="unified-page-header">
      <h1>{category}</h1>
      <p class="unified-page-subtitle">共 <span class="accent">{categoryPosts.length}</span> 篇文章</p>
    </div>

    {categoryPosts.length > 0 ? (
      <ul class="post-list">
        {categoryPosts.map((post) => (
          <PostCard
            slug={blogSlug(post.id)}
            title={post.data.title}
          description={post.data.description}
          body={post.body}
            pubDate={post.data.pubDate}
            category={category}
            tags={post.data.tags}
          />
        ))}
      </ul>
    ) : (
      <div class="empty-list">
        <div class="empty-list-icon">⊘</div>
        <p class="empty-list-text">该分类下暂无文章</p>
      </div>
    )}

    <div class="view-all">
      <a href={isRootBase ? '/categories' : base + '/categories'}>← 返回所有分类</a>
    </div>
  </section>
</BaseLayout>
