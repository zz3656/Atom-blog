---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CommandHeader from '../../components/CommandHeader.astro';
import { SITE_TITLE } from '../../consts';
import { normalizeCategory } from '../../utils/blog';
import { getPublishedPosts } from '../../utils/collection';
import { blogPostUrl, categoriesUrl } from '../../utils/path';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allCategories = new Set<string>();
  posts.forEach((post) => {
    allCategories.add(normalizeCategory(post.data.category));
  });

  return [...allCategories].map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;

const categoryPosts = (await getPublishedPosts()).filter(
  (post) => normalizeCategory(post.data.category) === category,
);
---

<BaseLayout title={`${category} | ${SITE_TITLE}`}>
  <section class="listing-page">
    <CommandHeader
      cmd={`ls -la ~/cats/${category}`}
      title={category}
      count={`共 ${categoryPosts.length} 篇文章`}
    />

    {
      categoryPosts.length > 0 ? (
        <ul class="ls-list">
          {categoryPosts.map((post, idx) => (
            <PostCard
              slug={blogPostUrl(post.id)}
              title={post.data.title}
              description={post.data.description}
              body={post.body}
              pubDate={post.data.pubDate}
              category={category}
              tags={post.data.tags}
              index={idx}
            />
          ))}
        </ul>
      ) : (
        <div class="empty-list">
          <div class="empty-list-icon" aria-hidden="true">
            ⊘
          </div>
          <p class="empty-list-text">该分类下暂无文章</p>
        </div>
      )
    }

    <div class="view-all">
      <a href={categoriesUrl()}>← $ cd ~/cats</a>
    </div>
  </section>
</BaseLayout>
