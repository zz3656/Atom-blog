---
import BaseLayout from '../layouts/BaseLayout.astro';
import { rootPath, blogListUrl } from '../utils/path';
---

<BaseLayout
  title="404 - 页面不存在"
  description="你访问的页面走丢了"
  type="website"
  pageUrl={String(Astro.site)}
>
  <section class="hero">
    <div class="hero-inner hero-inner--single">
      <div class="hero-main">
        <p class="hero-eyebrow">
          <span class="hero-eyebrow-mark"></span>
          Error 404
        </p>
        <h1>404</h1>
        <div class="rule rule--draw"></div>
        <p class="hero-desc">
          你访问的页面走丢了。
          <br />
          就像 IE 浏览器偶尔也会……嗯，好吧，因特吧从不会走丢。
        </p>
        <div class="hero-actions">
          <a href={rootPath()} class="btn btn-primary">
            回到首页 →
          </a>
          <a href={blogListUrl()} class="btn btn-secondary">
            浏览文章
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
