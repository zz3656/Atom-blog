---
import BaseLayout from '../layouts/BaseLayout.astro';
import { rootPath, blogListUrl } from '../utils/path';
---

<BaseLayout title="404 - 页面不存在" description="你访问的页面走丢了" type="website">
  <!-- 404 不该被收录：不设 canonical（指向首页会让搜索引擎把 404 当成首页副本） -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>
  <section class="hero">
    <div class="hero-inner hero-inner--single">
      <div class="hero-main">
        <p class="hero-eyebrow">
          <span class="hero-eyebrow-mark"></span>
          Error 404
        </p>
        <h1>404</h1>
        <div class="rule rule--draw"></div>
        <p class="hero-desc">
          你访问的页面走丢了。
          <br />
          就像 Atom 在拳击台上偶尔也会……嗯，好吧，Atom 从不会走丢。
        </p>
        <div class="hero-actions">
          <a href={rootPath()} class="btn btn-primary">
            回到首页 →
          </a>
          <a href={blogListUrl()} class="btn btn-secondary">
            浏览文章
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
