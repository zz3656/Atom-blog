---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TerminalAscii from '../components/TerminalAscii.astro';
import TerminalBoot from '../components/TerminalBoot.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  HERO_TITLE,
  HERO_DESCRIPTION,
  HERO_EYEBROW,
  HERO_EYEBROW_SUB,
  HERO_ACTIONS,
  POSTS_PER_PAGE,
} from '../consts';
import { getPublishedPosts } from '../utils/collection';
import { normalizeCategory } from '../utils/blog';
import { blogPostUrl, blogListUrl, baseAssetsPath } from '../utils/path';

const allPosts = await getPublishedPosts();
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE) || 1;
const totalPosts = allPosts.length;

// ===== 站点数据（全部来自真实内容，不做假数据）=====
const categoryCount = new Set(allPosts.map((p) => normalizeCategory(p.data.category))).size;
const tagCount = new Set(allPosts.flatMap((p) => p.data.tags ?? [])).size;

// 渲染时过滤掉被 hide 的按钮；空数组则不渲染整块 hero-actions
const visibleHeroActions = HERO_ACTIONS.filter((action) => !action.hide);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero hero--tui">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-mark" aria-hidden="true"></span>
        {HERO_EYEBROW}
        {HERO_EYEBROW_SUB && <span class="hero-eyebrow-sub">{HERO_EYEBROW_SUB}</span>}
      </p>

      <h1 class="hero-title">
        <TerminalAscii />
        <span class="sr-only" set:html={HERO_TITLE} />
      </h1>

      <TerminalBoot
        articles={totalPosts}
        categories={categoryCount}
        tags={tagCount}
        generator={Astro.generator}
      />

      <p class="hero-desc">{HERO_DESCRIPTION}</p>

      <p class="hero-prompt">
        <span class="hero-prompt-path" aria-hidden="true">~/yinteba $</span>
        <span class="cursor-block" aria-hidden="true"></span>
      </p>

      {
        visibleHeroActions.length > 0 && (
          <div class="hero-actions">
            {visibleHeroActions.map((action) => (
              <a
                href={baseAssetsPath(action.href)}
                class:list={['btn', `btn-${action.variant ?? 'primary'}`]}
              >
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="recent-posts">
    <div class="section-header">
      <div class="section-heading">
        <span class="section-eyebrow">ls -la ~/posts</span>
        <h2 class="section-title">最新文章</h2>
      </div>
      <span class="section-count">{totalPosts} entries</span>
    </div>

    <ul class="ls-list">
      {pagePosts.map((post, idx) => (
        <PostCard
          slug={blogPostUrl(post.id)}
          title={post.data.title}
          description={post.data.description}
          body={post.body}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          index={idx}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {pagePosts.length < allPosts.length && (
          <a href={blogListUrl()} class="page-btn next">
            $ ls ~/posts/2 →
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
