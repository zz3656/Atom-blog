---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Pagination settings
const POSTS_PER_PAGE = 12;
const totalPosts = posts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE) || 1;

export function getStaticPaths() {
  const paths: { params: { page?: string }; props: { page: number } }[] = [];
  for (let page = 1; page <= totalPages; page++) {
    paths.push({ params: page === 1 ? {} : { page: String(page) }, props: { page }});
  }
  return paths;
}

const currentPage = Astro.props.page || 1;
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = posts.slice(startIndex, startIndex + POSTS_PER_PAGE);

const getPageUrl = (p: number) => {
  if (p <= 1) return base + '/';
  return base + '/' + p + '/';
};
const pageNumbers: number[] = [];
for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>
      <svg class="hero-atom-icon" viewBox="0 0 32 32" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
        <circle cx="16" cy="16" r="14" fill="url(#heroIconBg)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(-30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(90 16 16)"/>
        <circle cx="16" cy="16" r="2.5" fill="#fff"/>
        <defs>
          <linearGradient id="heroIconBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#6366f1"/>
            <stop offset="100%" style="stop-color:#8b5cf6"/>
          </linearGradient>
          <linearGradient id="heroIconRing" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#e0e7ff"/>
            <stop offset="100%" style="stop-color:#a5b4fc"/>
          </linearGradient>
        </defs>
      </svg>
      Atom 博客
    </h1>
    <p class="hero-desc">
      一个简洁、快速、优雅的现代博客。基于 Astro 构建，零 JavaScript，
      Lighthouse 满分，为你的内容而生。
    </p>
    <div class="hero-actions">
      <a href={base + "/blog"} class="btn btn-primary">浏览文章 →</a>
      <a href={base + "/about"} class="btn btn-secondary">关于此博客</a>
    </div>
  </section>

  <section class="recent-posts">
    <div class="section-header">
      <h2 class="section-title">最新文章</h2>
      <span class="section-count">共 {totalPosts} 篇</span>
    </div>
    <ul class="post-grid">
      {paginatedPosts.map((post) => (
        <PostCard
          slug={base + "/blog/" + post.slug + "/"}
          title={post.data.title}
          pubDate={post.data.pubDate}
          description={post.data.description}
          category={post.data.category}
          tags={post.data.tags}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {currentPage > 1 && (
          <a href={getPageUrl(currentPage - 1)} class="page-btn prev">← 上一页</a>
        )}
        <div class="page-numbers">
          {pageNumbers.map((p) => (
            <a
              href={getPageUrl(p)}
              class:list={['page-link', p === currentPage && 'active']}
              aria-label={p === currentPage ? '当前页' : `第 ${p} 页`}
              aria-current={p === currentPage ? 'page' : undefined}
            >{p}</a>
          ))}
        </div>
        {currentPage < totalPages && (
          <a href={getPageUrl(currentPage + 1)} class="page-btn next">下一页 →</a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
