---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HeroIcon from '../components/HeroIcon.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_HERO_ICON,
  HERO_TITLE,
  HERO_DESCRIPTION,
  HERO_EYEBROW,
  HERO_EYEBROW_SUB,
  HERO_ACTIONS,
  POSTS_PER_PAGE,
} from '../consts';
import { getPublishedPosts } from '../utils/collection';
import { normalizeCategory } from '../utils/blog';
import { formatDateISO } from '../utils/date';
import { blogPostUrl, blogListUrl, baseAssetsPath } from '../utils/path';

const allPosts = await getPublishedPosts();
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE) || 1;
const totalPosts = allPosts.length;

// ===== 站点数据（全部来自真实内容，不做假数据）=====
const categorySet = new Set(allPosts.map((p) => normalizeCategory(p.data.category)));
const tagSet = new Set(allPosts.flatMap((p) => p.data.tags ?? []));
const latestDate = allPosts.length > 0 ? allPosts[0].data.pubDate : null;

// 渲染时过滤掉被 hide 的按钮；空数组则不渲染整块 hero-actions
const visibleHeroActions = HERO_ACTIONS.filter((action) => !action.hide);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-main">
        <p class="hero-eyebrow">
          <span class="hero-eyebrow-mark"></span>
          {HERO_EYEBROW}
          {HERO_EYEBROW_SUB && <span class="hero-eyebrow-sub">{HERO_EYEBROW_SUB}</span>}
        </p>
        <h1>
          <HeroIcon src={SITE_HERO_ICON} />
          <Fragment set:html={HERO_TITLE} />
        </h1>
        <div class="rule rule--draw"></div>
        <p class="hero-desc">{HERO_DESCRIPTION}</p>
        {visibleHeroActions.length > 0 && (
          <div class="hero-actions">
            {visibleHeroActions.map((action) => (
              <a
                href={baseAssetsPath(action.href)}
                class:list={['btn', `btn-${action.variant ?? 'primary'}`]}
              >
                {action.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <aside class="hero-telemetry" aria-label="站点数据">
        <p class="telemetry-label">Telemetry</p>
        <dl class="telemetry-list">
          <div class="telemetry-row">
            <dt>Posts</dt>
            <dd>{String(totalPosts).padStart(2, '0')}</dd>
          </div>
          <div class="telemetry-row">
            <dt>Categories</dt>
            <dd>{String(categorySet.size).padStart(2, '0')}</dd>
          </div>
          <div class="telemetry-row">
            <dt>Tags</dt>
            <dd>{String(tagSet.size).padStart(2, '0')}</dd>
          </div>
          {latestDate && (
            <div class="telemetry-row telemetry-row--wide">
              <dt>Latest</dt>
              <dd>{formatDateISO(latestDate)}</dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </section>

  <section class="recent-posts">
    <div class="section-header">
      <div class="section-heading">
        <span class="section-eyebrow">Latest Entries</span>
        <h2 class="section-title">最新文章</h2>
      </div>
      <span class="section-count">共 {totalPosts} 篇</span>
    </div>
    <div class="rule section-rule rule--draw"></div>

    <ul class="log-list">
      {pagePosts.map((post, idx) => (
        <PostCard
          slug={blogPostUrl(post.id)}
          title={post.data.title}
          description={post.data.description}
          body={post.body}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          index={idx}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {pagePosts.length < allPosts.length && (
          <a href={blogListUrl()} class="page-btn next">
            更多文章 →
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
