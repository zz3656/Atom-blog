---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title="关于 | Atom Blog">
  <section class="about">
    <div class="unified-page-header">
      <h1>关于此博客</h1>
    </div>
    <div class="about-content">
      <p>
        你好！这是 <strong>Atom 博客</strong>，一个基于 <a href="https://astro.build" target="_blank">Astro</a> 构建的现代静态博客。
        项目灵感来自电影《铁甲钢拳》(Real Steel) 中的机器人 Atom —
        小巧、精准、充满力量。
      </p>

      <h2>🎯 设计理念</h2>
      <p>Atom 博客追求简洁、快速、优雅。我们相信好的博客应该：</p>
      <ul>
        <li>🚀 <strong>极快</strong> — 零 JavaScript，纯 HTML，Lighthouse 满分</li>
        <li>📝 <strong>专注内容</strong> — Markdown 写作，无需后台</li>
        <li>🌙 <strong>优雅体验</strong> — 暗黑模式，响应式布局</li>
        <li>🔍 <strong>SEO 友好</strong> — 内置 RSS、Sitemap、Open Graph</li>
      </ul>

      <h2>🛠️ 技术栈</h2>
      <div class="about-projects">
        <div class="project-card">
          <h3>⚡ Astro</h3>
          <p>现代静态站点生成器，零 JS 默认输出，内容优先架构。</p>
          <div class="project-links">
            <a href="https://astro.build" target="_blank" class="tag">官网</a>
          </div>
        </div>
        <div class="project-card">
          <h3>📘 TypeScript</h3>
          <p>类型安全的开发体验，编辑器智能提示，内容 Schema 校验。</p>
          <div class="project-links">
            <a href="https://www.typescriptlang.org" target="_blank" class="tag">官网</a>
          </div>
        </div>
        <div class="project-card">
          <h3>🐙 GitHub Pages</h3>
          <p>免费静态站点托管，GitHub Actions 自动构建部署。</p>
          <div class="project-links">
            <a href="https://pages.github.com" target="_blank" class="tag">官网</a>
          </div>
        </div>
      </div>

      <h2>💬 联系我</h2>
      <p>如果你对这个项目感兴趣，欢迎 Star 或 Fork！</p>
      <div class="about-links">
        {SOCIAL_LINKS.github && <a href={SOCIAL_LINKS.github} target="_blank" class="btn btn-secondary">GitHub</a>}
        {SOCIAL_LINKS.email && <a href={SOCIAL_LINKS.email} class="btn btn-secondary">Email</a>}
      </div>
    </div>
  </section>
</BaseLayout>
