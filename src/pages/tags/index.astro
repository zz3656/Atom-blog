---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/collection';
import { getTagUrl } from '../../utils/path';

const posts = await getPublishedPosts();

// Collect all unique tags
const tagMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(post);
  });
});

const sortedTags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title={`所有标签 | ${SITE_TITLE}`}>
  <section class="listing-page">
    <div class="unified-page-header">
      <p class="unified-page-eyebrow">Taxonomy</p>
      <h1>所有标签</h1>
      <div class="rule"></div>
      <p class="unified-page-subtitle">
        共 <span class="accent">{sortedTags.length}</span> 个标签 ·{' '}
        <span class="accent">{posts.length}</span> 篇文章
      </p>
    </div>

    {sortedTags.length > 0 ? (
      <div class="tag-grid">
        {sortedTags.map(([tag, tagPosts]) => (
          <a href={getTagUrl(tag)} class="tag-card">
            <span class="tag-card-label">{tag}</span>
            <span class="tag-card-count">{tagPosts.length}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无标签</p>
    )}
  </section>
</BaseLayout>
