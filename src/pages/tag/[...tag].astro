---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/collection';
import { blogPostUrl, tagsUrl } from '../../utils/path';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allTags = new Set<string>();
  posts.forEach((post) => {
    (post.data.tags || []).forEach((tag) => allTags.add(tag));
  });

  return [...allTags].map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const tagPosts = (await getPublishedPosts()).filter((post) => post.data.tags?.includes(tag));
---

<BaseLayout title={`${tag} | ${SITE_TITLE}`}>
  <section class="listing-page">
    <div class="unified-page-header">
      <p class="unified-page-eyebrow">Tag</p>
      <h1>{tag}</h1>
      <div class="rule"></div>
      <p class="unified-page-subtitle">
        共 <span class="accent">{tagPosts.length}</span> 篇文章
      </p>
    </div>

    {tagPosts.length > 0 ? (
      <ul class="log-list">
        {tagPosts.map((post) => (
          <PostCard
            slug={blogPostUrl(post.id)}
            title={post.data.title}
            description={post.data.description}
            body={post.body}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </ul>
    ) : (
      <div class="empty-list">
        <div class="empty-list-icon">⊘</div>
        <p class="empty-list-text">该标签下暂无文章</p>
      </div>
    )}

    <div class="view-all">
      <a href={tagsUrl()}>← 返回所有标签</a>
    </div>
  </section>
</BaseLayout>
