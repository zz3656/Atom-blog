---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 12;
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE) || 1;

  const paths = [];
  for (let page = 1; page <= totalPages; page++) {
    const startIndex = (page - 1) * POSTS_PER_PAGE;
    const pagePosts = allPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);
    paths.push({
      params: { page: page === 1 ? undefined : String(page) },
      props: { page, pagePosts, totalPosts: allPosts.length, totalPages },
    });
  }
  return paths;
}

const { page = 1, pagePosts, totalPosts, totalPages } = Astro.props;

const getPageUrl = (p: number) => {
  if (p <= 1) return base + '/blog/';
  return base + `/blog/${p}/`;
};
const pageNumbers: number[] = [];
for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
---

<BaseLayout title={`所有文章 | 第${page}页`} description="查看所有文章">
  <section class="blog-list">
    <div class="blog-list-header">
      <h1>📝 所有文章</h1>
      <p class="blog-count">共 {totalPosts} 篇</p>
    </div>
    <ul class="post-list">
      {pagePosts.map((post, idx) => (
        <PostCard
          key={post.id}
          slug={base + "/blog/" + post.id + "/"}
          title={post.data.title}
          description={post.data.description}
          body={post.body}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          index={idx}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {page > 1 && (
          <a href={getPageUrl(page - 1)} class="page-btn prev">← 上一页</a>
        )}
        <div class="page-numbers">
          {pageNumbers.map((p) => (
            <a
              href={getPageUrl(p)}
              class:list={['page-link', p === page && 'active']}
              aria-label={p === page ? '当前页' : `第 ${p} 页`}
              aria-current={p === page ? 'page' : undefined}
            >{p}</a>
          ))}
        </div>
        {page < totalPages && (
          <a href={getPageUrl(page + 1)} class="page-btn next">下一页 →</a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
