---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { POSTS_PER_PAGE, SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/collection';
import { paginationInfo } from '../../utils/pagination';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const totalPosts = allPosts.length;
  const { totalPages } = paginationInfo(totalPosts, POSTS_PER_PAGE);

  // 只为第 2 页及之后生成路径：第 1 页由 index.astro 负责
  // 路径形如 /blog/2/、/blog/3/ ...
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: String(page) },
      props: { allPosts, currentPage: page, totalPages, totalPosts },
    });
  }
  return paths;
}

const { allPosts, currentPage, totalPages, totalPosts } = Astro.props;
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const pagePosts = allPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);
---

<BaseLayout
  title={`所有文章 | 第 ${currentPage} 页 | ${SITE_TITLE}`}
  description={`${SITE_TITLE} 文章列表第 ${currentPage} 页（共 ${totalPages} 页）。`}
>
  <section class="blog-list">
    <div class="unified-page-header">
      <p class="unified-page-eyebrow">Archive</p>
      <h1>所有文章</h1>
      <div class="rule"></div>
      <p class="unified-page-subtitle">共 {totalPosts} 篇</p>
    </div>

    <PostList posts={pagePosts} startIndex={startIndex} />
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </section>
</BaseLayout>
