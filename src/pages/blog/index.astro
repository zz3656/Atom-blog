---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { getPublishedPosts } from '../../utils/collection';
import { blogPostUrl, blogListUrl } from '../../utils/path';

const allPosts = await getPublishedPosts();
const totalPosts = allPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE) || 1;
// 第 1 页：固定渲染前 POSTS_PER_PAGE 篇
const paginatedPosts = allPosts.slice(0, POSTS_PER_PAGE);

const getPageUrl = (p: number) => {
  if (p <= 1) return blogListUrl();
  return `${blogListUrl()}${p}/`;
};
const pageNumbers: number[] = [];
for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
---

<BaseLayout title="所有文章 | Atom Blog" description="查看所有文章">
  <section class="blog-list">
    <div class="unified-page-header">
      <h1>所有文章</h1>
      <p class="unified-page-subtitle">共 {totalPosts} 篇</p>
    </div>
    <ul class="post-list">
      {paginatedPosts.map((post, idx) => (
        <PostCard
          slug={blogPostUrl(post.id)}
          title={post.data.title}
          description={post.data.description}
          body={post.body}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          index={idx}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        <div class="page-numbers">
          {pageNumbers.map((p) => (
            <a
              href={getPageUrl(p)}
              class:list={['page-link', p === 1 && 'active']}
              aria-label={p === 1 ? '当前页' : `第 ${p} 页`}
              aria-current={p === 1 ? 'page' : undefined}
            >
              {p}
            </a>
          ))}
        </div>
        <a href={getPageUrl(2)} class="page-btn next">
          下一页 →
        </a>
      </nav>
    )}
  </section>
</BaseLayout>
