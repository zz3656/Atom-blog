---
import { extractSummary } from '../utils/blog';
import { formatDateISO } from '../utils/date';

interface Props {
  slug: string;
  title: string;
  pubDate: Date;
  description?: string;
  category?: string;
  tags?: string[];
  index?: number | undefined;
  body?: string;
}

const { slug, title, pubDate, description, category = '', tags = [], body = '' } = Astro.props;
const idx = 'index' in Astro.props ? Astro.props.index : undefined;

// Auto-extract description from body if description is empty
const postDesc = description || extractSummary(body);
// 序号：传了 index 就用（01/02/03…），没传就从日期倒序自行编号
const ordinal = idx != null ? String(idx + 1).padStart(2, '0') : null;
---

<li class="log-row">
  <a href={slug}>
    {ordinal && <span class="log-index">{ordinal}</span>}
    <span class="log-title">{title}</span>
    <time class="log-date" datetime={pubDate.toISOString()}>
      {formatDateISO(pubDate)}
    </time>
    {postDesc && <span class="log-desc">{postDesc}</span>}
    {category && (
      <span class="log-category">
        <span class="post-category-tag">{category}</span>
      </span>
    )}
    {tags.length > 0 && (
      <span class="log-tags">
        {tags.slice(0, 4).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
        {tags.length > 4 && <span class="tag">+{tags.length - 4}</span>}
      </span>
    )}
  </a>
</li>
