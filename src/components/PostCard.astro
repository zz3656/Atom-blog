---
interface Props {
  slug: string;
  title: string;
  pubDate: Date;
  description: string;
  category?: string;
  tags?: string[];
  index?: number | undefined;
  body?: string;
}

import FormattedDate from './FormattedDate.astro';

const { slug, title, pubDate, description, category = '', tags = [], index, body = '' } = Astro.props;
const idx = 'index' in Astro.props ? Astro.props.index : undefined;

// Auto-extract description from body if description is empty
let postDesc = description;
if (!postDesc && body) {
  let content = body.replace(/^---[\s\S]*?---/, '').trim();
  content = content.replace(/^\s*>.*$/gm, '').replace(/^\s*\n/gm, '').trim();
  const paragraphs = content.split(/\n\s*\n/);
  if (paragraphs.length > 0) {
    let para = paragraphs[0].replace(/[#*`_~\[\]()!&\x3e]/g, '').trim();
    postDesc = para.length > 120 ? para.slice(0, 120) + '\u2026' : para;
  }
}
---

<li class="post-card">
  <a href={slug}>
    {idx != null && (
      <div class="post-card-index">{String(idx + 1).padStart(2, '0')}</div>
    )}
    <div class="post-card-body">
      <h2 class="post-card-title">{title}</h2>
      {postDesc && <p class="post-card-desc">{postDesc}</p>}
      <div class="post-card-meta">
        <div class="meta-top">
          <time datetime={pubDate.toISOString()} class="post-card-date">
            {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
          {category && (
            <span class="post-card-category">{category}</span>
          )}
        </div>
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.slice(0, 4).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {tags.length > 4 && (
              <span class="tag">+{tags.length - 4}</span>
            )}
          </div>
        )}
      </div>
    </div>
  </a>
</li>
