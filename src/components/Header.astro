---
import { SOCIAL_LINKS } from '../consts';

const base = import.meta.env.BASE_URL;
// Astro 的 meta 处理问题：当 base='' 时 /xxx 会被编译成 //xxx（协议相对 URL）
// 解决方案：根据 base 决定链接的写法
const isRootBase = base === '/' || base === '';

const currentPage = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '';

const navLinks = [
  { label: '首页', active: currentPage === '' },
  { label: '文章', active: currentPage.startsWith('blog') },
  { label: '分类', active: currentPage === 'categories' },
  { label: '标签', active: currentPage === 'tags' },
  { label: '关于', active: currentPage === 'about' },
];

const linkPaths = isRootBase ? ['/', '/blog', '/categories', '/tags', '/about'] : [base, base + '/blog', base + '/categories', base + '/tags', base + '/about'];
const rssUrl = isRootBase ? '/rss.xml' : `${base}/rss.xml`;
---

<header class="site-header">
  <nav class="nav-container">
    <a href={linkPaths[0]} class="site-title">
      <svg class="atom-icon" viewBox="0 0 32 32" width="24" height="24" xmlns="http://www.w3.org/2000/svg">
        <circle cx="16" cy="16" r="14" fill="url(#iconBg)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#iconRing)" stroke-width="1.5" transform="rotate(30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#iconRing)" stroke-width="1.5" transform="rotate(-30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#iconRing)" stroke-width="1.5" transform="rotate(90 16 16)"/>
        <circle cx="16" cy="16" r="2.5" fill="#fff"/>
        <defs>
          <linearGradient id="iconBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#6366f1"/>
            <stop offset="100%" style="stop-color:#8b5cf6"/>
          </linearGradient>
          <linearGradient id="iconRing" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#e0e7ff"/>
            <stop offset="100%" style="stop-color:#a5b4fc"/>
          </linearGradient>
        </defs>
      </svg>
      Atom
    </a>
    <div class="nav-links">
      {navLinks.map((link, i) => (
        <a href={linkPaths[i]} class:list={['nav-link', link.active && 'active']}>{link.label}</a>
      ))}
      <div class="nav-actions">
        <div class="search-wrapper">
          <input
            type="text"
            id="search-input"
            class="search-input"
            placeholder="搜索文章…"
            aria-label="搜索文章"
            autocomplete="off"
          />
          <div id="search-results" class="search-results"></div>
        </div>
        <div class="theme-toggle" id="theme-toggle" aria-label="切换暗黑模式" style="cursor:pointer;">🌙</div>
        <a href={rssUrl} class="theme-toggle" aria-label="RSS 订阅" style="text-decoration:none;font-size:1.1rem;cursor:pointer;">📡</a>
      </div>
    </div>
  </nav>
</header>
