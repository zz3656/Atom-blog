---
import { SITE_NAME, SITE_LOGO } from '../consts';
import {
  baseAssetsPath,
  rootPath,
  blogListUrl,
  categoriesUrl,
  tagsUrl,
  aboutUrl,
  stripBase,
} from '../utils/path';

const logoSrc = baseAssetsPath(SITE_LOGO);

// 高亮判定必须先去 base：子路径部署下 pathname 是 `/Atom/blog/`，
// 直接跟 `/blog` 比较永远不相等（历史上 GitHub Pages 全线不亮就是这个原因）。
const currentPath = stripBase(Astro.url.pathname);

const navLinks = [
  { label: '首页', href: rootPath(), active: currentPath === '/' },
  {
    label: '文章',
    href: blogListUrl(),
    active: currentPath === '/blog/' || currentPath.startsWith('/blog/'),
  },
  {
    label: '分类',
    href: categoriesUrl(),
    active: currentPath === '/categories/',
  },
  { label: '标签', href: tagsUrl(), active: currentPath === '/tags/' },
  { label: '关于', href: aboutUrl(), active: currentPath === '/about/' },
];
---

<header class="site-header">
  <nav class="nav-container">
    <a href={rootPath()} class="site-title">
      <img src={logoSrc} alt="" class="site-logo" width="26" height="26" />
      <span class="site-name-text">{SITE_NAME}</span>
      <span class="site-tagline">Precision Log</span>
    </a>

    <!-- Hamburger toggle button (mobile only) -->
    <button class="nav-toggle" id="nav-toggle" aria-label="切换菜单" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- link.href 已由 path.ts 的工具函数带上 base，这里不能再包一层 baseAssetsPath，
         否则 base 会被拼接两次（v1.1.4 线上整站导航 404 就是这么来的） -->
    <div class="nav-links" id="nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class:list={['nav-link', link.active && 'active']}>
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-actions">
      <div class="search-wrapper">
        <span class="search-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="search-results"
          autocomplete="off"
          data-search-trigger
        />
        <div
          id="search-results"
          class="search-results"
          role="listbox"
          aria-label="搜索结果"
          aria-live="polite"
        >
        </div>
      </div>

      <!-- 主题开关：日 / 夜 双档。图标高亮由 CSS 依据 html[data-mode] 决定 -->
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换深色/浅色模式">
        <span class="theme-icon theme-icon-sun" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
          </svg>
        </span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.5 14.2A8.6 8.6 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7Z"></path>
          </svg>
        </span>
      </button>
    </div>
  </nav>
</header>
