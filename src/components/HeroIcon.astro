---
// Hero 图标 — 首页 Hero 区域"Atom 博客"前的图标
// 默认渲染内置的 Atom 原子 SVG；若通过 prop 传入 src，则改用自定义图片，
// 让用户可以在 src/consts.ts 的 SITE_HERO_ICON 中替换为任意图片。
import { baseAssetsPath } from '../utils/path';

interface Props {
  width?: number;
  height?: number;
  className?: string;
  src?: string; // 自定义图片路径（如 '/heroes/hero.svg'）。空值/未传则渲染内置 SVG
}

const { width = 36, height = 36, className = 'hero-atom-icon', src } = Astro.props;
const customSrc = src ? baseAssetsPath(src) : '';
---

{customSrc ? (
  <img
    src={customSrc}
    alt=""
    class={className}
    width={width}
    height={height}
    aria-hidden="true"
  />
) : (
  <svg
    class={className}
    viewBox="0 0 32 32"
    width={width}
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <circle cx="16" cy="16" r="14" fill="url(#heroIconBg)" />
    <ellipse
      cx="16"
      cy="16"
      rx="11"
      ry="5"
      fill="none"
      stroke="url(#heroIconRing)"
      stroke-width="1.5"
      transform="rotate(30 16 16)"
    />
    <ellipse
      cx="16"
      cy="16"
      rx="11"
      ry="5"
      fill="none"
      stroke="url(#heroIconRing)"
      stroke-width="1.5"
      transform="rotate(-30 16 16)"
    />
    <ellipse
      cx="16"
      cy="16"
      rx="11"
      ry="5"
      fill="none"
      stroke="url(#heroIconRing)"
      stroke-width="1.5"
      transform="rotate(90 16 16)"
    />
    <circle cx="16" cy="16" r="2.5" fill="#fff" />
    <defs>
      <linearGradient id="heroIconBg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#6366f1" />
        <stop offset="100%" style="stop-color:#8b5cf6" />
      </linearGradient>
      <linearGradient id="heroIconRing" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#e0e7ff" />
        <stop offset="100%" style="stop-color:#a5b4fc" />
      </linearGradient>
    </defs>
  </svg>
)}