---
// Hero 图标 — 首页 Hero 区域标题前的标识
// 站点标识「黄铜原子」：冷钢底 + 黄铜轨道。
// 图形由本机 Draw Things（SDXL Turbo / Z-Image Turbo）生成原图，
// 再经矢量描摹得到，颜色强制对齐设计系统 token（--accent / --bg-primary）。
// 若通过 prop 传入 src，则改用自定义图片，让用户可以在 src/consts.ts 的
// SITE_HERO_ICON 中替换为任意图片。
import { baseAssetsPath } from '../utils/path';

interface Props {
  width?: number;
  height?: number;
  className?: string;
  src?: string; // 自定义图片路径（如 '/heroes/hero.svg'）。空值/未传则渲染内置 SVG
}

const { width = 36, height = 36, className = 'hero-atom-icon', src } = Astro.props;
const customSrc = src ? baseAssetsPath(src) : '';
---

{customSrc ? (
  <img src={customSrc} alt="" class={className} width={width} height={height} aria-hidden="true" />
) : (
  <svg
    class={className}
    viewBox="0 0 32 32"
    width={width}
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs><radialGradient id="heroDisc" cx="34%" cy="26%" r="84%">
      <stop offset="0%" stop-color="#454f59"/>
      <stop offset="55%" stop-color="#252c33"/>
      <stop offset="100%" stop-color="#14181c"/>
    </radialGradient><linearGradient id="heroBrass" x1="10%" x2="90%" y1="4%" y2="98%">
      <stop offset="0%" stop-color="#f7d488"/>
      <stop offset="50%" stop-color="#e2a93a"/>
      <stop offset="100%" stop-color="#a66b11"/>
    </linearGradient>
    </defs>
      <path fill="url(#heroDisc)" fill-rule="evenodd" d="M14.36.75h3.28l2.53.5 2.27.76 3.27 2.01 2.27 2.27 1.51 2.27 1.76 5.55-.25 5.31-.76 2.52-2.26 3.77-4.04 3.53-2 1-3.77 1.01h-4.31l-1.19-.5h-1.09l-1.52-.51-3.52-2.01-2.77-2.77-1.01-1.52-1.26-2.77-.75-3.28.25-5.31 1.01-3.02 2.01-3.27 2.27-2.27 2.27-1.51 3.27-1.26 2.5-.5zM15.64 14l-1.37 1.04-.27.82.26 1.08.85.81 1.83-.01L18 16.42l-.52-1.88-.81-.54z"/>
      <path fill="url(#heroBrass)" fill-rule="evenodd" d="m15.61 5.5 1.08.01 1.29 1.03 1.08 2.7 2.05-.49h1.81l1.04.52.54.84-.26 2.83-1.99 2.92 1.99 3.2.25 2.63-1.03 1.29-.79.27-3.63-.48-.81 2.44-1.56 1.29-1.36-.01-1.54-1.28-.83-2.45-3.36.49-1.04-.27-1.04-1.34.51-3.08 1.74-2.42-2-3.47-.25-2.31.51-1.05 1.35-.56 3.58.49 1.33-2.95 1.31-.79zM9.64 9.75l-1.12.79-.02.88 1.01 2.27 1.1 1.31 1.63-1.31.51-3.11-1.83-.83zM21.39 17l-1.63 1.56-.26 3.08 2.08.61 1.38-.27.53-.54.01-1.08-.77-1.82L21.42 17zm.5-7.25-2.39.86.26 2.83 1.6 1.56 1.62-2.04.52-1.32-.02-1.1-.54-.53-1.02-.26zM10.64 17l-1.13 1.31-1.01 2.27.27 1.13 1.06.54h.84l1.83-.83-.26-2.86L10.67 17zm5.25 4.25L14 22.36l.51 1.83 1.1 1.31.83-.01.54-.53L18 22.89l-.29-.87-1.79-.77zm.25-14.75-1.37 1.04L14 9.36l.29.62 1.54.77L18 9.89l-.76-2.33-1.07-1.06zm2.25 13-1.14.86.04.37 1.07.52.39-1.36-.33-.39zM13.64 11l-.28 1.75 1.39-1.08-.04-.4-1.04-.27zm4.5 0-.89.61.86.64.39-.11v-1.06l-.33-.08zm-4.5 8.75L13.58 21l1.17-.36-1.08-.89z"/>
      <path fill="url(#heroBrass)" fill-rule="evenodd" d="m15.86 13.25 1.85.52.79 1.31-.26 2.36-1.57 1.06-2.11-.26-1.06-1.32.27-2.38 1.02-1.02 1.04-.27zm.28-1-1.85 1.02-1.02 1.02-.27.82.26 2.83 2.35 1.81 1.08-.26 1.77-1.26.54-1.09-.26-3.08-2.57-1.81z"/>
  </svg>
)}
