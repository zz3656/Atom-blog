---
import { REPO_URL, SOCIAL_LINKS, SITE_NAME, SITE_VERSION } from '../consts';
import { rssUrl, aboutUrl } from '../utils/path';

const year = new Date().getFullYear();

// "Powered by Atom" 中的 Atom——与用户站点名(SITE_NAME)解耦，
// 不应被用户客制化时修改。
const FRAMEWORK_NAME = 'Atom';

// 个人社交链接（不包含 GitHub —— GitHub 单独处理）
const socialLinks = [
  SOCIAL_LINKS.twitter
    ? { href: SOCIAL_LINKS.twitter, label: 'Twitter', target: '_blank', rel: 'noopener' }
    : null,
  SOCIAL_LINKS.email ? { href: `mailto:${SOCIAL_LINKS.email}`, label: 'Email' } : null,
].filter(Boolean);
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-brand-name">{SITE_NAME}</span>
        <span class="footer-brand-tag">Precision Log</span>
      </div>
      <div class="footer-links">
        {SOCIAL_LINKS.github && (
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" title="作者 GitHub">
            GitHub
          </a>
        )}
        {socialLinks.map(
          (link) =>
            link && (
              <a href={link.href} target={link.target || undefined} rel={link.rel || undefined}>
                {link.label}
              </a>
            ),
        )}
        <a href={rssUrl()} target="_blank" rel="noopener">
          RSS
        </a>
        <a href={aboutUrl()}>关于</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-built">
        © {year}{' '}
        <a href={REPO_URL} target="_blank" rel="noopener">
          {FRAMEWORK_NAME}
        </a>
      </span>
      <span class="footer-meta">
        {/* 版本号是真实数据 —— 沿用页脚的 mono 字体 */}
        <span class="footer-version" title={`Atom Blog v${SITE_VERSION}`}>v{SITE_VERSION}</span>
        <span>
          Powered by{' '}
          <a href="https://astro.build" target="_blank" rel="noopener">
            Astro
          </a>
        </span>
      </span>
    </div>
  </div>
</footer>
