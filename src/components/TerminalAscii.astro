---
/**
 * 终端字标 —— 「因特吧」的块字符点阵
 *
 * 5 行 × 41 列，由 5×5 点阵字库逐格渲染（每个字母 5 列 + 1 列间隔 = 41 列）。
 * 纯装饰：aria-hidden，站点名语义由外层 <h1> 的 visually-hidden 文本承担。
 *
 * 重新生成的方法（Python，供日后改字时复用）：
 *   FONT = { 'Y': ['█   █',' █ █ ','  █  ','  █  ','  █  '], ... }
 *   行 = " ".join(FONT[ch][r] for ch in word)   # word = 'YINTEBA', r = 0..4
 */
const WORDMARK = [
  '█   █ █████ █   █ █████ █████ ████   ███ ',
  ' █ █    █   ██  █   █   █     █   █ █   █',
  '  █     █   █ █ █   █   ████  ████  █████',
  '  █     █   █  ██   █   █     █   █ █   █',
  '  █   █████ █   █   █   █████ ████  █   █',
];
---

<pre class="term-wordmark" aria-hidden="true">{WORDMARK.join('\n')}</pre>
