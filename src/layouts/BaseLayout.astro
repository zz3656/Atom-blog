---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  AUTHOR,
  SITE_FAVICON,
  DEFAULT_THEME_COLORS,
  OG_IMAGE,
} from '../consts';
import { rssUrl, baseAssetsPath, absoluteUrl } from '../utils/path';
import { themes } from '../generated/themes';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** 覆盖 og:url/canonical (默认用当前页面 URL，404 页可覆盖为主页) */
  pageUrl?: string;
}

const { title, description, image, type = 'website', pageUrl } = Astro.props;
const canonicalUrl = pageUrl || String(Astro.url);
const fullTitle = title;
const desc = description || SITE_DESCRIPTION;
const rssLink = rssUrl();
const faviconLink = baseAssetsPath(SITE_FAVICON);
const searchBase = baseAssetsPath('/');

// OG/Twitter 图：文章自带封面优先，否则用默认分享图（SVG favicon 社交平台不认）
const ogImage = absoluteUrl(image || OG_IMAGE);

// 主题清单（构建时由 theme-loader 自动生成，仅包含有效主题 ID）
// 用于内联脚本的运行时校验，防止老用户 localStorage 中的过期主题 ID 被吞
const themeIds = themes.map((t) => t.id);
// 默认主题：清单中第一个
const defaultThemeId = themeIds[0] || 'atom-geek';
// 浏览器地址栏配色随主题走（组件层不写死颜色）
const defaultTheme = themes.find((t) => t.id === defaultThemeId);
const themeColorLight = defaultTheme?.themeColor?.light ?? DEFAULT_THEME_COLORS.light;
const themeColorDark = defaultTheme?.themeColor?.dark ?? DEFAULT_THEME_COLORS.dark;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- CSP & Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:site_name" content={SITE_TITLE} />

    <!-- canonical URL: 避免 /blog/foo 与 /blog/foo/ 被重复索引 -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssLink} />

    <link rel="icon" type="image/svg+xml" href={faviconLink} />
    <link rel="apple-touch-icon" sizes="180x180" href={baseAssetsPath('/apple-touch-icon.png')} />

    <!-- PWA Manifest -->
    <link rel="manifest" href={baseAssetsPath('/manifest.json')} />

    <!-- 字体已自托管（fontsource），见 src/styles/global.css 顶部；
         不再向 fonts.googleapis.com 发请求（大陆不可达时会挂住首屏渲染） -->
    <title>{fullTitle}</title>
    <script is:inline define:vars={{ defaultThemeId, themeIds }}>
      // Apply theme synchronously before page render to avoid FOUC
      // 多主题系统: localStorage.themeId (主题 ID) + localStorage.themeMode ('light'|'dark')
      // VALID_IDS 与 DEFAULT_ID 由构建时注入（来自 src/generated/themes.ts），
      // 新增/删除主题后会自动同步，无需手动维护硬编码列表。
      (function () {
        var html = document.documentElement;
        var id = localStorage.getItem('themeId');
        var mode = localStorage.getItem('themeMode');
        if (!id || themeIds.indexOf(id) === -1) id = defaultThemeId;
        if (mode !== 'light' && mode !== 'dark') {
          mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        html.setAttribute('data-theme', id);
        html.setAttribute('data-mode', mode);
      })();
    </script>
    <slot name="head" />
    <noscript>
      <style>
        /* JS disabled 时：默认浅色 + 调整布局避免主题按钮占位 */
        html {
          color-scheme: light;
        }
        .theme-toggle {
          display: none;
        }
      </style>
      <div class="noscript-note">
        本站某些功能（主题切换 / 搜索 / 代码复制）需要 JavaScript。基础阅读不受影响。
      </div>
    </noscript>
  </head>
  <body data-search-base={searchBase}>
    <a class="skip-link" href="#main-content">
      跳到主要内容
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button id="back-to-top" class="back-to-top" aria-label="返回顶部" type="button">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script src={baseAssetsPath('/js/app.js')} defer></script>
  </body>
</html>
