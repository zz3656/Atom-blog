# 构建输出
dist/

# 构建产物中的临时资产（search-index.json 会被重新生成）
public/_assets/

# prebuild minify 产物（源在 src/scripts/app.js，scripts/minify-app-js.mjs 生成这里）
public/js/
# 同上：minify 脚本为子路径部署额外生成（public/<base>/js/app.js）
public/*/js/

# 依赖
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 测试覆盖率
coverage/
src/generated/

# Astro 生成目录（types.d.ts / content.d.ts / collections schema 等全是构建产物，
# 由 dev/build/astro check 自动重建；入库只会制造 diff 噪音与版本漂移）
.astro/

# 环境变量（本地建 .env 前必须已在忽略列表里；示例文件可入库）
.env
.env.*
!.env.example
