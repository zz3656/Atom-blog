# 构建输出
dist/

# 构建产物中的临时资产（search-index.json 会被重新生成）
public/_assets/

# postbuild minify 产物（源在 src/scripts/app.js，scripts/minify-app-js.mjs 生成这里）
public/js/
# 同上：minify 脚本为子路径部署额外生成（public/<base>/js/app.js）
public/*/js/

# 依赖
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 测试覆盖率
coverage/
src/generated/

# Astro dev server 缓存（.astro 下其余类型文件是被 git 跟踪的）
.astro/data-store.json
.astro/dev.json
.astro/settings.json
.astro/preview.json
