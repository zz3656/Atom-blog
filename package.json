{
  "name": "atom",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/minify-app-js.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,astro,css,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,astro,css,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "new": "node scripts/atom-cli.mjs new",
    "list": "node scripts/atom-cli.mjs list",
    "theme:create": "node scripts/create-theme.mjs",
    "postbuild": "node --experimental-strip-types scripts/generate-rss.mjs && node scripts/fix-sitemap.mjs"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.8"
  },
  "dependencies": {
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
